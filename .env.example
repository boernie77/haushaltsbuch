# Pflicht
DB_PASSWORD=bitte_aendern
# JWT_SECRET: langer Zufallswert, z.B. openssl rand -hex 32
JWT_SECRET=bitte_langen_zufallswert_eintragen
# ENCRYPTION_KEY: verschlüsselt API-Keys, Tokens und Passwörter in der DB.
# Erzeugen mit: openssl rand -hex 32 (genau 64 Hex-Zeichen). Gut sichern —
# ohne ihn sind diese Felder nach einer Wiederherstellung unlesbar.
ENCRYPTION_KEY=
APP_URL=https://haushalt.example.com
API_URL=https://haushalt.example.com/api
ALLOWED_ORIGINS=https://haushalt.example.com

# KI (optional) — alternativ eigener Key pro Haushaltsbuch in der App
ANTHROPIC_API_KEY=

# E-Mail für Passwort-Reset und Monatsberichte (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Single Sign-on per OpenID Connect (optional; leer = aus)
# z.B. OIDC_ISSUER_URL=https://auth.example.com/application/o/haushaltsbuch/
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Betreiberangaben für Impressum und Datenschutz (optional, bei öffentlichem
# Betrieb meist Pflicht). Adresse kommagetrennt.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_HOSTING=
LEGAL_AUTHORITY=

# Link zum Quellcode, falls du eine geänderte Version betreibst (AGPL)
SOURCE_URL=
